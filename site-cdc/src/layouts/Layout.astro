---
// src/layouts/Layout.astro

export interface Props {
  title: string;
  description: string;
  image?: string; // Imagem opcional para compartilhamento (ex: WhatsApp)
}

const { 
  title, 
  description, 
  image = "/assets/logodeitadacdc.png" // Imagem padrão se nenhuma for passada
} = Astro.props;

// Gera URLs absolutas para SEO
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#640404" />
  <link rel="canonical" href={canonicalURL} />

  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <link rel="manifest" href="/assets/site.webmanifest" />

  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/base.css" />
  <link rel="stylesheet" href="/css/eventos.css" />
  <link rel="stylesheet" href="/css/home.css" />
  <link rel="stylesheet" href="/css/clube.css" />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={socialImageURL} />

  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={canonicalURL} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={socialImageURL} />

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ButcherShop",
      "name": "Código da Carne",
      "image": "https://codigodacarne.com.br/assets/logodeitadacdc.png",
      "@id": "https://codigodacarne.com.br",
      "url": "https://codigodacarne.com.br",
      "telephone": "+554330252586",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "R. Paranaguá, 1306 - Centro",
        "addressLocality": "Londrina",
        "addressRegion": "PR",
        "postalCode": "86020-031",
        "addressCountry": "BR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -23.3117,
        "longitude": -51.1581
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": [
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday"
        ],
        "opens": "09:00",
        "closes": "18:30"
      },
      "sameAs": [
        "https://www.instagram.com/codigodacarne/",
        "https://www.facebook.com/codigodacarne"
      ]
    }
  </script>
</head>

<body>
  <div class="topbar">
    <div class="container topbar__wrap">
      <a class="brand" href="/" aria-label="Código da Carne">
        <img src="/assets/logodeitadacdc.png" alt="Código da Carne" class="brand__logo-deitada" />
      </a>
      <a id="onbeef-button" class="btn btn-topbar-shop" href="https://codigo-da-carne.onbeef.app.br/" target="_blank" rel="noopener">
        <span class="onbeef-text">Compre Aqui</span>
        <img src="/assets/carrinho.png" alt="Carrinho" class="onbeef-logo" />
      </a>
      </div>
  </div>

  <header class="header" role="banner">
    <div class="container header__wrap">
      <nav class="nav" aria-label="Principal">
        <button id="navToggle" class="nav__toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu">☰</button>
        <ul id="menu" class="nav__list">
          <li><a class="nav__link" href="/">HOME</a></li>
          <li><a class="nav__link" href="/eventos">EVENTOS</a></li>
          <li><a class="nav__link" href="/clube">CLUBE</a></li>
          <li><a class="nav__link" href="/lojas">LOJAS</a></li>
          <li><a class="nav__link" href="/quem-somos">QUEM SOMOS</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main class="container" aria-live="polite">
    <slot />
  </main>

  <footer class="footer">
    <div class="container footer__wrap">
      <p>DA SELEÇÃO AO CORTE PERFEITO, CUIDAMOS DE CADA DETALHE.</p>
      <div class="footer__socials">
        <a href="https://api.whatsapp.com/send?phone=554330252586" target="_blank" rel="noopener" aria-label="WhatsApp">WHATSAPP</a>
        <a href="https://www.instagram.com/codigodacarne/" target="_blank" rel="noopener" aria-label="Instagram">INSTAGRAM</a>
        <a href="https://www.facebook.com/codigodacarne" target="_blank" rel="noopener" aria-label="Facebook">FACEBOOK</a>
        <a href="https://linkedin.com/codigodacarne" target="_blank" rel="noopener" aria-label="LinkedIn">LINKEDIN</a>
      </div>
      <small>© <span id="year"></span> CÓDIGO DA CARNE · TODOS OS DIREITOS RESERVADOS</small>
    </div>
  </footer>

  <div class="created-by-bar">
    <a href="https://www.linkedin.com/in/luisguilhermeborges" target="_blank" rel="noopener" aria-label="LinkedIn de Luis Guilherme Borges">
      <span>Desenvolvido por:</span>
      <img src="/assets/lb107-logo.png" alt="Logo LB107">
    </a>
  </div>

  <a
    class="whatsapp-fab"
    href="https://api.whatsapp.com/send?phone=554330252586"
    target="_blank" rel="noopener" aria-label="Falar no WhatsApp">
    <img src="/assets/whatsapp.png" alt="WhatsApp">
  </a>

  <script>
    document.getElementById('year').textContent = new Date().getFullYear().toString();
  </script>
  
  <script>
    const navToggle = document.getElementById("navToggle");
    const menu = document.getElementById("menu");
    if (navToggle && menu) {
      // Abre e fecha o menu ao clicar no botão
      navToggle.addEventListener("click", () => {
        const isOpen = menu.classList.toggle("is-open");
        navToggle.setAttribute("aria-expanded", String(isOpen));
        navToggle.textContent = isOpen ? '✕' : '☰';
      });
      // Fecha o menu se clicar FORA dele
      document.addEventListener("click", (e) => {
        if (menu.classList.contains('is-open') && !menu.contains(e.target) && !navToggle.contains(e.target)) {
          menu.classList.remove("is-open");
          navToggle.setAttribute("aria-expanded", "false");
          navToggle.textContent = '☰';
        }
      });
      // Fecha o menu se clicar em um LINK do menu (importante para mobile)
      menu.addEventListener("click", (e) => {
        if (e.target.closest("a[href]")) {
           menu.classList.remove("is-open");
           navToggle.setAttribute("aria-expanded", "false");
           navToggle.textContent = '☰';
        }
      });
    }
  </script>
</body>
</html>